[
  {
    "id": "github",
    "name": "GitHub",
    "description": "Triage issues, pull requests and repositories",
    "url": "https://api.githubcopilot.com/mcp/",
    "scope": "repo read:org read:user",
    "oauthApp": "github"
  },
  {
    "id": "gmail",
    "name": "Gmail",
    "description": "Search, read and draft email",
    "url": "https://gmailmcp.googleapis.com/mcp/v1",
    "scope": "https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose",
    "oauthApp": "google",
    "authParams": { "access_type": "offline", "prompt": "consent" }
  },
  {
    "id": "drive",
    "name": "Google Drive",
    "description": "Find and read Docs, Sheets and Slides",
    "url": "https://drivemcp.googleapis.com/mcp/v1",
    "scope": "https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file",
    "oauthApp": "google",
    "authParams": { "access_type": "offline", "prompt": "consent" }
  },
  {
    "id": "calendar",
    "name": "Google Calendar",
    "description": "Check your schedule, find free time and manage events",
    "url": "https://calendarmcp.googleapis.com/mcp/v1",
    "scope": "https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.events.freebusy https://www.googleapis.com/auth/calendar.events",
    "oauthApp": "google",
    "authParams": { "access_type": "offline", "prompt": "consent" }
  },
  {
    "id": "notion",
    "name": "Notion",
    "description": "Search, read and edit pages and databases",
    "url": "https://mcp.notion.com/mcp"
  }
]
