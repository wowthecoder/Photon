{
  "name": "photon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "web": "vite",
    "build": "tsc && vite build",
    "start": "npm run build && electron .",
    "dist": "node scripts/fetch-llama.js && node scripts/fetch-sd.js && npm run build && electron-builder --mac",
    "test": "node src/catalog.test.ts && node src/imageCatalog.test.ts && node electron/download.test.js && node electron/mcp.test.js"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "description": "Local LLM chat for macOS",
  "main": "electron/main.js",
  "build": {
    "appId": "com.photon.app",
    "productName": "Photon",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "resources/llama",
        "to": "llama"
      },
      {
        "from": "resources/sd",
        "to": "sd"
      }
    ]
  },
  "productName": "Photon",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
